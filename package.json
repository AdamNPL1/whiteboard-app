    "backup:verify": "node --env-file=.env.backup.local scripts/verify-backup.mjs",
    "backup:check": "node --env-file=.env.backup.local scripts/check-backup-readiness.mjs",
    "backup:restore:test": "node --env-file=.env.backup.local --env-file=.env.restore.local scripts/restore-supabase.mjs"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "bcrypt": "^6.0.0",
    "konva": "^10.3.0",
    "lucide-react": "^1.7.0",
    "next": "^16.3.4",
    "nodemailer": "^9.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.5",
    "react-rnd": "^10.5.3",
    "stripe": "^22.2.3",
    "tldraw": "^4.5.12",
