{
  "name": "blackboard-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "launch:check": "node --env-file=.env.local scripts/check-launch-readiness.mjs",
