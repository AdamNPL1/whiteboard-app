# Generate a cryptographically random 32-byte key and store it in a trusted
# password manager as well as GitHub Actions secrets. Never commit the value.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=

# Fail npm run backup:check when the newest backup is older than this.
BACKUP_MAX_AGE_HOURS=26

